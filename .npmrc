strict-peer-deps=true
save-exact=false
min-release-age=7

# `trustPolicy: no-downgrade` in pnpm-workspace.yaml checks every lockfile entry's publish date,
# which means fetching full registry metadata for each package. When one of those documents is slow
# -- @prisma/engines carries every version it has ever published -- the check cannot complete, and it
# correctly refuses to treat "could not check" as "passed". pnpm's defaults give it 2 retries and a
# 60s timeout, which was not enough: see #787, where one metadata timeout failed lint, typecheck,
# docs-build and coverage-gate at once on an unrelated pull request.
#
# Raising the budget rather than excluding the package, because the exclusion list is for publish
# histories that genuinely cannot satisfy the policy, not for slow downloads.
fetch-retries=4
fetch-timeout=120000
