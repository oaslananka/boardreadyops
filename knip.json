{
  "$schema": "https://unpkg.com/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/cli/index.ts",
        "src/cli/binary.ts",
        "src/action/index.ts",
        "src/core/errors.ts",
        "scripts/*.mjs",
        "tests/**/*.test.ts",
        "tests/benchmark/**/*.ts"
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs"]
    },
    "apps/web": {
      "entry": ["worker.ts"],
      "project": ["lib/**/*.{ts,js}", "app/api/github/webhook/**/*.{ts,js}", "components/review/**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "class-variance-authority",
        "lucide-react",
        "next-themes",
        "radix-ui",
        "tailwindcss",
        "tw-animate-css"
      ],
      "ignore": ["lib/utils.ts"]
    }
  },
  "ignoreBinaries": ["psql"]
}
