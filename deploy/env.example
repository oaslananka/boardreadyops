APP_URL=https://boardreadyops.oaslananka.dev
NEXT_PUBLIC_APP_URL=https://boardreadyops.oaslananka.dev
NODE_ENV=production

POSTGRES_USER=boardreadyops
POSTGRES_PASSWORD=change-this-before-deploy
POSTGRES_DB=boardreadyops
DATABASE_URL=postgresql://boardreadyops:change-this-before-deploy@postgres:5432/boardreadyops
REDIS_URL=redis://redis:6379

ARTIFACT_STORAGE_DRIVER=local
ARTIFACT_STORAGE_ROOT=/data/artifacts
ARTIFACT_DOWNLOAD_SIGNING_KEY=replace-with-at-least-32-random-characters

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

RUNNER_CALLBACK_SECRET=
SESSION_SECRET=
BOARDREADYOPS_RUNNER_RESULT_KEY=

# Default execution runs in each target repository's GitHub Actions environment.
BOARDREADYOPS_RUNNER_MODE=github-actions
BOARDREADYOPS_DISPATCH_WORKFLOW=readiness-runner.yml
BOARDREADYOPS_PUBLIC_URL=https://boardreadyops.oaslananka.dev
BOARDREADYOPS_RELEASE_REPOSITORIES=owner/repository
# BOARDREADYOPS_RELEASE_REPOSITORIES_FILE=/run/policies/repositories

# Optional enterprise/customer self-hosted mode only.
BOARDREADYOPS_SELF_HOSTED_RUNNER_LABEL=default
BOARDREADYOPS_SELF_HOSTED_RUNNER_REQUIRE_SAFE_MODE=1

# Durable control-plane worker. One process may claim several jobs concurrently;
# PostgreSQL leases prevent duplicate claims across replicas.
BOARDREADYOPS_WORKER_CONCURRENCY=4
BOARDREADYOPS_WORKER_POLL_MS=1000
BOARDREADYOPS_WORKER_METRICS_INTERVAL_MS=30000
BOARDREADYOPS_WORKER_RETENTION_CLEANUP_INTERVAL_MS=3600000
BOARDREADYOPS_WORKER_HEALTH_PORT=3001

# GitHub workflow and Check Run reconciliation. Candidate detection begins only
# after the observation window; every item receives an explicit terminal deadline.
BOARDREADYOPS_RECONCILIATION_CONCURRENCY=2
BOARDREADYOPS_RECONCILIATION_POLL_MS=5000
BOARDREADYOPS_RECONCILIATION_DETECT_INTERVAL_MS=30000
BOARDREADYOPS_RECONCILIATION_OBSERVATION_SECONDS=300
BOARDREADYOPS_RECONCILIATION_DEADLINE_SECONDS=1800
BOARDREADYOPS_RECONCILIATION_NEXT_CHECK_SECONDS=60

# Internal control-plane operator API. Keep the endpoints behind a private
# network or authenticated administrative proxy. Generate a high-entropy token;
# the actor ID is a stable non-secret audit identity.
BOARDREADYOPS_OPERATOR_API_TOKEN=
BOARDREADYOPS_OPERATOR_ACTOR_ID=operator.primary

# Per-process authenticated webhook guard. Immediate retries of the same
# X-GitHub-Delivery value remain idempotently accepted.
BOARDREADYOPS_WEBHOOK_RATE_LIMIT_PER_MINUTE=1200
